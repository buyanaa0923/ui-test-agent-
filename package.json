{
  "name": "mole-agent",
  "version": "0.4.0",
  "description": "Mole digs up UI bugs before your users do: checks your running app against your design and modern design practice, points every defect at its file:line, and judges the doubtful ones with a Jev to Claude to human ladder.",
  "type": "module",
  "bin": {
    "mole": "bin/mole.mjs"
  },
  "files": [
    "bin",
    "src",
    "config",
    "assets",
    "plugin",
    ".claude-plugin",
    "scripts/dev/ensure-deps.mjs"
  ],
  "scripts": {
    "mole": "node bin/mole.mjs",
    "dig": "node bin/mole.mjs dig",
    "scan": "node bin/mole.mjs dig",
    "flow": "node bin/mole.mjs tunnel",
    "tunnel": "node bin/mole.mjs tunnel",
    "ci": "node bin/mole.mjs ci",
    "doctor": "node bin/mole.mjs doctor",
    "dashboard": "node bin/mole.mjs dashboard",
    "mcp": "node bin/mole.mjs mcp",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/quality/smoke.mjs",
    "bench": "node scripts/quality/bench.mjs",
    "determinism": "node scripts/quality/determinism.mjs",
    "consistency": "node scripts/quality/consistency.mjs",
    "evidence": "node scripts/quality/evidence.mjs",
    "eval:jev": "node scripts/eval/eval-jev.mjs",
    "eval:replay": "node scripts/eval/eval-jev.mjs --replay",
    "eval:real": "node scripts/eval/eval-real.mjs",
    "eval:real:replay": "node scripts/eval/eval-real.mjs --replay",
    "real:collect": "node scripts/eval/collect-real.mjs",
    "real:labels": "node scripts/eval/real-labels.mjs",
    "scorecard": "node scripts/eval/scorecard-export.mjs",
    "import-tokens": "node scripts/dev/import-tokens.mjs",
    "jev:ping": "node scripts/dev/jev-ping.mjs",
    "jev:raw": "node scripts/dev/jev-raw.mjs",
    "build:sprite": "node scripts/dev/build-sprite.mjs",
    "trace:png": "node scripts/dev/trace-to-png.mjs",
    "setup": "bash setup.sh"
  },
  "keywords": ["ui-testing", "design-system", "playwright", "claude-code", "mcp"],
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
