# Copy to .env (never commit it, never paste keys into chat). Load with: set -a; source .env; set +a

# Jev (TypeSafe System One): fast typed micro-decisions with calibrated confidence. Get the key from the TypeSafe console.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Claude: rules on the cases Jev is unsure about, and is the comparison baseline.
# api = Anthropic API key from your work Console. cli = the company `claude -p` runner (cost shows as unpriced).
JUDGE_MODE=api
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-5-5

# Cascade: Jev decides alone only above these confidences. Dismissing a finding needs the higher bar on purpose.
GATE_CONFIRM=0.8
GATE_DISMISS=0.9

# Hard stop per run, in USD
BUDGET_USD=1

# Flow explorer: heuristic (free, local) or jev
PICKER=heuristic

# Only if Playwright's own Chromium is not installed
CHROMIUM_PATH=
