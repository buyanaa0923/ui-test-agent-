# For running Mole from a terminal. Copy to .env (loaded automatically; never commit it, never paste keys into chat).
# In Claude Code, set these in /plugin > Installed > mole > Configure options instead (stored in the OS keychain).

# Jev (TypeSafe System One): fast typed micro-decisions with calibrated confidence. Get the key from the TypeSafe console.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Claude: rules on the cases Jev is unsure about, and is the comparison baseline.
# api = an Anthropic Console API key. cli = your own Claude Code login through `claude -p` (no key; cost shows as unpriced).
JUDGE_MODE=api
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-5-5

# Cascade: Jev decides alone only above these confidences. Dismissing a finding needs the higher bar on purpose.
GATE_CONFIRM=0.8
GATE_DISMISS=0.9

# Hard stop per run, in USD
BUDGET_USD=1

# Flow explorer: heuristic (free, local) or jev
PICKER=heuristic

# Only if neither Playwright's Chromium nor Google Chrome / Microsoft Edge is installed
CHROMIUM_PATH=

# Optional
# MOLE_RUNS_DIR=        where run folders go (default ./runs)
# MOLE_DESIGN=          a DESIGN.md to use when none is in the working directory
# MOLE_SRC_ROOT=        the source folder for file:line locations (default: the DESIGN.md's project, else here)
# MOLE_WATCH=1          always show the live panel; MOLE_HEADLESS=1 never opens a window (CI)
